{
  "name": "kosher-zmanim",
  "version": "0.8.2",
  "description": "A library for calculating zmanim, based on KosherJava.",
  "author": "BehindTheMath",
  "license": "LGPL-3.0",
  "bugs": "BehindTheMath/KosherZmanim/issues",
  "homepage": "BehindTheMath/KosherZmanim",
  "repository": "BehindTheMath/KosherZmanim",
  "main": "dist/kosher-zmanim.esm.js",
  "types": "dist/kosher-zmanim.esm.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist/* -g",
    "build": "npm run clean && tsup && rimraf dist/types && cp src/hebrewcalendar/limud/dataSets/hiloulah-en.json dist/hiloulah-en.json && cp src/hebrewcalendar/limud/dataSets/hiloulah-he.json dist/hiloulah-he.json",
    "lint": "eslint --ext .ts src tests",
    "test": "mocha",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "zmanim",
    "zman",
    "kosherzmanim",
    "kosher-zmanim",
    "kosherjava"
  ],
  "files": [
    "dist/*"
  ],
  "dependencies": {
    "big.js": "^7.0.1",
    "temporal-polyfill": "0.3.0"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "chai": "^5.2.1",
    "esbuild": "^0.25.9",
    "esbuild-plugin-d.ts": "^1.3.1",
    "eslint": "^9.33.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.32.0",
    "mocha": "^11.7.1",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
